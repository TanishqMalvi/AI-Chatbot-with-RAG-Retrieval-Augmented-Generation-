APP_NAME=HealthTech-RAG-Assistant
APP_ENV=development
LOG_LEVEL=INFO

OPENAI_API_KEY=your_openai_api_key_here
JWT_SECRET_KEY=any-long-random-words-you-make-up
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-4o-mini

LLM_PROVIDER=openai
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

VECTOR_DB=chroma
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=healthtech_rag

PINECONE_API_KEY=pcsk_...
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=healthtech-rag

REDIS_URL=redis://localhost:6379/0

# Database
DATABASE_URL=sqlite:///./healthtech_rag.db

JWT_SECRET_KEY=change-me-in-production-use-256bit-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin seeding (set these to create initial admin user on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

RETRIEVAL_TOP_K=20
RERANK_TOP_N=6
MAX_CONTEXT_CHUNKS=6
RERANKER_MODEL=BAAI/bge-reranker-large

ENABLE_PII_REDACTION=true
ENABLE_PROMPT_INJECTION_CHECK=true
ENABLE_HALLUCINATION_CHECK=true
CONFIDENCE_THRESHOLD=0.35

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=healthtech-rag

INGEST_BATCH_SIZE=32
INGEST_WEBHOOK_SECRET=change-me-webhook-secret
