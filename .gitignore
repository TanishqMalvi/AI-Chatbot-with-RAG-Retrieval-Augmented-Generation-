# ============================================================
# Application Settings
# ============================================================
APP_NAME=HealthTech-RAG-Assistant
APP_ENV=development  # development | production
LOG_LEVEL=INFO

# ============================================================
# OpenAI (required for embeddings + generation)
# ============================================================
OPENAI_API_KEY=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
OPENAI_EMBEDDING_MODEL=text-embedding-3-large  # or text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# ============================================================
# Anthropic Claude fallback (optional)
# Set LLM_PROVIDER=anthropic to use Claude instead of OpenAI
# ============================================================
LLM_PROVIDER=openai  # openai | anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================================
# Vector Database
# Set VECTOR_DB=pinecone to switch from Chroma to Pinecone
# ============================================================
VECTOR_DB=chroma  # chroma | pinecone
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=healthtech_rag

# Pinecone (only needed when VECTOR_DB=pinecone)
PINECONE_API_KEY=pcsk_...
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=healthtech-rag

# ============================================================
# Redis (caching)
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# JWT Authentication
# ============================================================
JWT_SECRET_KEY=change-me-in-production-use-256bit-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================
# Retrieval Settings
# ============================================================
RETRIEVAL_TOP_K=20          # candidates before reranking
RERANK_TOP_N=6              # final chunks sent to LLM
MAX_CONTEXT_CHUNKS=6
RERANKER_MODEL=BAAI/bge-reranker-large

# ============================================================
# Guardrails
# ============================================================
ENABLE_PII_REDACTION=true
ENABLE_PROMPT_INJECTION_CHECK=true
ENABLE_HALLUCINATION_CHECK=true
CONFIDENCE_THRESHOLD=0.35

# ============================================================
# Observability (LangSmith)
# ============================================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=healthtech-rag

# ============================================================
# Ingestion
# ============================================================
INGEST_BATCH_SIZE=32
INGEST_WEBHOOK_SECRET=change-me-webhook-secret
